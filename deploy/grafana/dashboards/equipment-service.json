{
  "uid": "equipment-service",
  "title": "Equipment Maintenance Service",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "4xx / 5xx response ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"4..\"}[5m])) / sum(rate(http_requests_total[5m]))",
          "legendFormat": "4xx ratio"
        },
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Response time p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Service availability",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [{ "expr": "up{job=\"equipment-api\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Requests by status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT status, count(*) AS value FROM maintenance_requests GROUP BY status"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 6,
      "title": "Requests by priority",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT priority, count(*) AS value FROM maintenance_requests GROUP BY priority"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "id": 7,
      "title": "Average closure time (hours)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT AVG(EXTRACT(EPOCH FROM (rsh.changed_at - mr.created_at)) / 3600) AS value FROM maintenance_requests mr JOIN request_status_history rsh ON rsh.request_id = mr.id AND rsh.new_status IN ('done','rejected')"
        }
      ]
    },
    {
      "id": 8,
      "title": "Equipment load (top 10 by requests)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT e.name AS metric, count(mr.id) AS value FROM equipment e LEFT JOIN maintenance_requests mr ON mr.equipment_id = e.id GROUP BY e.name ORDER BY value DESC LIMIT 10"
        }
      ]
    }
  ]
}
