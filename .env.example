PORT=3000
NODE_ENV=development # только для локальной разработки, в продакшене использовать production
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_MAX_PRECIPITATION_MM=0
WEATHER_MAX_WIND_SPEED_KMH=20
REQUEST_TIMEOUT_MS=5000
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_TOKEN_TTL=15m

# Для образа базы данных PostgreSQL
POSTGRES_DB=equipment_maintenance
POSTGRES_USER=user
POSTGRES_PASSWORD=

# Для подключения к базе данных PostgreSQL из приложения
PGHOST=localhost
PGPORT=5433
PGDATABASE=equipment_maintenance
PGUSER=user
PGPASSWORD=

METRICS_USER=metrics
METRICS_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TECHNICIAN_EMAIL=
SEED_TECHNICIAN_PASSWORD=